rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{titleId} {
      allow list: if true;
    }
    match /videos/{titleId}/{fileName} {
      allow read: if true;
      allow create: if resource == null
        && titleId.matches('[a-z0-9][a-z0-9-]{0,63}')
        && fileName.matches('[a-f0-9-]{36}\\.mp4')
        && request.resource.size >= 12 && request.resource.size <= 5000000000
        && request.resource.contentType == 'video/mp4'
        && request.resource.metadata.titleId == titleId;
      // A new unique object is used for each replacement. Existing videos are
      // never overwritten or deleted as a side effect of editing a title.
      allow update, delete: if false;
    }
    match /{path=**} { allow read, write: if false; }
  }
}
