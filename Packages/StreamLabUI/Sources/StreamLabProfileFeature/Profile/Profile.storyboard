<?xml version='1.0' encoding='UTF-8'?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="vc-Profiles">
    <device id="retina6_12" orientation="portrait" appearance="dark" />
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23501" />
        <capability name="Safe area layout guides" minToolsVersion="9.0" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <scenes>
        <scene sceneID="scene-Profiles">
            <objects>
                <viewController storyboardIdentifier="Profiles" id="vc-Profiles" customClass="ProfileViewController" customModule="StreamLabProfileFeature">
                    <view key="view" contentMode="scaleToFill" id="root-Profiles">
                        <rect key="frame" x="0" y="0" width="393" height="852" />
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                        <subviews>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="scroll-Profiles">
                                <rect key="frame" x="0" y="59" width="393" height="759" />
                                <subviews>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="24" translatesAutoresizingMaskIntoConstraints="NO" id="stack-Profiles">
                                        <rect key="frame" x="24" y="32" width="345" height="500" />
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="STREAMLAB" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="profile-heading">
                                                <rect key="frame" x="0" y="0" width="340" height="60" />
                                                <fontDescription key="fontDescription" type="system" pointSize="20" />
                                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
                                            </label>
                                            <button opaque="NO" contentMode="scaleToFill" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="alex">
                                                <rect key="frame" x="0" y="0" width="340" height="56" />
                                                <state key="normal" title="Alex" />
                                            </button>
                                            <button opaque="NO" contentMode="scaleToFill" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="jamie">
                                                <rect key="frame" x="0" y="0" width="340" height="56" />
                                                <state key="normal" title="Jamie" />
                                            </button>
                                            <button opaque="NO" contentMode="scaleToFill" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="kids">
                                                <rect key="frame" x="0" y="0" width="340" height="56" />
                                                <state key="normal" title="Kids" />
                                            </button>
                                        </subviews>
                                    </stackView>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="stack-Profiles" firstAttribute="leading" secondItem="content-Profiles" secondAttribute="leading" constant="24" id="c1" />
                                    <constraint firstItem="stack-Profiles" firstAttribute="trailing" secondItem="content-Profiles" secondAttribute="trailing" constant="-24" id="c2" />
                                    <constraint firstItem="stack-Profiles" firstAttribute="top" secondItem="content-Profiles" secondAttribute="top" constant="32" id="c3" />
                                    <constraint firstItem="stack-Profiles" firstAttribute="bottom" secondItem="content-Profiles" secondAttribute="bottom" constant="-32" id="c4" />
                                    <constraint firstItem="stack-Profiles" firstAttribute="width" secondItem="frame-Profiles" secondAttribute="width" constant="-48" id="c5" />
                                </constraints>
                                <viewLayoutGuide key="contentLayoutGuide" id="content-Profiles" />
                                <viewLayoutGuide key="frameLayoutGuide" id="frame-Profiles" />
                            </scrollView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-Profiles" />
                        <color key="backgroundColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
                        <constraints>
                            <constraint firstItem="scroll-Profiles" firstAttribute="leading" secondItem="safe-Profiles" secondAttribute="leading" constant="0" id="c6" />
                            <constraint firstItem="scroll-Profiles" firstAttribute="trailing" secondItem="safe-Profiles" secondAttribute="trailing" constant="0" id="c7" />
                            <constraint firstItem="scroll-Profiles" firstAttribute="top" secondItem="safe-Profiles" secondAttribute="top" constant="0" id="c8" />
                            <constraint firstItem="scroll-Profiles" firstAttribute="bottom" secondItem="safe-Profiles" secondAttribute="bottom" constant="0" id="c9" />
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="headingLabel" destination="profile-heading" id="out-Profiles-headingLabel" />
                        <outlet property="alexButton" destination="alex" id="out-Profiles-alexButton" />
                        <outlet property="jamieButton" destination="jamie" id="out-Profiles-jamieButton" />
                        <outlet property="kidsButton" destination="kids" id="out-Profiles-kidsButton" />
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-Profiles" userLabel="First Responder" sceneMemberID="firstResponder" />
            </objects>
        </scene>
    </scenes>
</document>