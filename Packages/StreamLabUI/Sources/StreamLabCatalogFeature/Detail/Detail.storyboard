<?xml version='1.0' encoding='UTF-8'?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="23501" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="vc-Detail">
    <device id="retina6_12" orientation="portrait" appearance="dark" />
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="23501" />
        <capability name="Safe area layout guides" minToolsVersion="9.0" />
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0" />
    </dependencies>
    <scenes>
        <scene sceneID="scene-Detail">
            <objects>
                <viewController sceneMemberID="viewController" storyboardIdentifier="Detail" id="vc-Detail" customClass="DetailViewController" customModule="StreamLabCatalogFeature">
                    <view key="view" contentMode="scaleToFill" id="root-Detail">
                        <rect key="frame" x="0" y="0" width="393" height="852" />
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES" />
                        <subviews>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="scroll-Detail">
                                <rect key="frame" x="0" y="59" width="393" height="759" />
                                <subviews>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="24" translatesAutoresizingMaskIntoConstraints="NO" id="stack-Detail">
                                        <rect key="frame" x="24" y="32" width="345" height="500" />
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="콘텐츠 상세" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="detail-title">
                                                <rect key="frame" x="0" y="0" width="340" height="60" />
                                                <fontDescription key="fontDescription" type="system" pointSize="20" />
                                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
                                            </label>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="detail-meta">
                                                <rect key="frame" x="0" y="0" width="340" height="60" />
                                                <fontDescription key="fontDescription" type="system" pointSize="20" />
                                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
                                            </label>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="detail-synopsis">
                                                <rect key="frame" x="0" y="0" width="340" height="60" />
                                                <fontDescription key="fontDescription" type="system" pointSize="20" />
                                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
                                            </label>
                                            <button opaque="NO" contentMode="scaleToFill" buttonType="system" translatesAutoresizingMaskIntoConstraints="NO" id="detail-play">
                                                <rect key="frame" x="0" y="0" width="340" height="56" />
                                                <state key="normal" title="재생 · Phase 2 예정" />
                                            </button>
                                        </subviews>
                                    </stackView>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="stack-Detail" firstAttribute="leading" secondItem="content-Detail" secondAttribute="leading" constant="24" id="c30" />
                                    <constraint firstItem="stack-Detail" firstAttribute="trailing" secondItem="content-Detail" secondAttribute="trailing" constant="-24" id="c31" />
                                    <constraint firstItem="stack-Detail" firstAttribute="top" secondItem="content-Detail" secondAttribute="top" constant="32" id="c32" />
                                    <constraint firstItem="stack-Detail" firstAttribute="bottom" secondItem="content-Detail" secondAttribute="bottom" constant="-32" id="c33" />
                                    <constraint firstItem="stack-Detail" firstAttribute="width" secondItem="frame-Detail" secondAttribute="width" constant="-48" id="c34" />
                                </constraints>
                                <viewLayoutGuide key="contentLayoutGuide" id="content-Detail" />
                                <viewLayoutGuide key="frameLayoutGuide" id="frame-Detail" />
                            </scrollView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-Detail" />
                        <color key="backgroundColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace" />
                        <constraints>
                            <constraint firstItem="scroll-Detail" firstAttribute="leading" secondItem="safe-Detail" secondAttribute="leading" constant="0" id="c35" />
                            <constraint firstItem="scroll-Detail" firstAttribute="trailing" secondItem="safe-Detail" secondAttribute="trailing" constant="0" id="c36" />
                            <constraint firstItem="scroll-Detail" firstAttribute="top" secondItem="safe-Detail" secondAttribute="top" constant="0" id="c37" />
                            <constraint firstItem="scroll-Detail" firstAttribute="bottom" secondItem="safe-Detail" secondAttribute="bottom" constant="0" id="c38" />
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="titleLabel" destination="detail-title" id="out-Detail-titleLabel" />
                        <outlet property="metadataLabel" destination="detail-meta" id="out-Detail-metadataLabel" />
                        <outlet property="synopsisLabel" destination="detail-synopsis" id="out-Detail-synopsisLabel" />
                        <outlet property="playbackButton" destination="detail-play" id="out-Detail-playbackButton" />
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-Detail" userLabel="First Responder" sceneMemberID="firstResponder" />
            </objects>
